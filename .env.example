NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# Public R2 origin serving activity.json / status.json for the "live internet
# intelligence" panel. Unset means the panel falls back to placeholders and the
# per-hour activity tiles hide entirely (see lib/live-activity-guard.ts).
NEXT_PUBLIC_WEBSITE_STATS_URL=https://pub-f2251a15327b429780b7ee354ff19e1b.r2.dev

# Forwarding of enquiry and contact submissions by email. BOTH are required in
# any deploy whose forms are live: without them a submission is logged and the
# visitor is told to email us directly instead (see lib/email.ts).
#
# EMAIL_FROM has NO fallback on purpose. It used to fall back to Resend's
# onboarding@resend.dev, which only delivers to the Resend account owner, so a
# misconfigured deploy dropped every submission while looking healthy.
# It must be a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Datazag <noreply@notifications.datazag.com>"

# Where enquiry-form submissions are sent. The form's enquiry type names a
# product, not a sales-vs-support split, so EVERY submission goes here for now
# and a human forwards what belongs to support. Unset falls back to
# sales@datazag.com. (CONTACT_EMAIL_TO is no longer read.)
SALES_EMAIL_TO=
