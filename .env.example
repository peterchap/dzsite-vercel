NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# READ-ONLY. Every page read uses it. It cannot create or patch documents, by
# design — see SANITY_WRITE_TOKEN below.
SANITY_API_TOKEN=

# WRITE-SCOPED (Editor). Required by the blog subscription routes, which create
# a subscriber document and later patch it to "active". Without it those routes
# fail loudly and say so; with SANITY_API_TOKEN they failed with a 403 from the
# middle of the flow. Kept separate so write access to the production dataset is
# not attached to every page render. Mint one at sanity.io/manage → your project
# → API → Tokens, with the Editor role.
SANITY_WRITE_TOKEN=

# Public R2 origin serving activity.json / status.json for the "live internet
# intelligence" panel. Unset means the panel falls back to placeholders and the
# per-hour activity tiles hide entirely (see lib/live-activity-guard.ts).
NEXT_PUBLIC_WEBSITE_STATS_URL=https://pub-f2251a15327b429780b7ee354ff19e1b.r2.dev

# Canonical site origin. Absolute links are built from it, including the blog
# subscription confirmation link, which is mailed out and so must not be
# derived from the request's own Host header. Unset falls back to
# https://www.datazag.com in production and to the request origin in dev.
NEXT_PUBLIC_SITE_URL=

# Outbound mail: enquiry and contact forwarding, and the blog subscription
# confirmation. BOTH are required in any deploy whose forms are live: without
# them a submission is logged and the visitor is told so rather than being
# shown a success that did not happen (see lib/email.ts).
#
# EMAIL_FROM has NO fallback on purpose. It used to fall back to Resend's
# onboarding@resend.dev, which only delivers to the Resend account owner, so a
# misconfigured deploy dropped every submission while looking healthy.
# It must be a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Datazag <noreply@notifications.datazag.com>"

# Where enquiry-form submissions are sent. The form's enquiry type names a
# product, not a sales-vs-support split, so EVERY submission goes here for now
# and a human forwards what belongs to support. Unset falls back to
# sales@datazag.com. (CONTACT_EMAIL_TO is no longer read.)
SALES_EMAIL_TO=

# Where a reply to the blog subscription confirmation goes. That mail is sent
# from a noreply@ address nobody reads, so replies are pointed at a published
# route instead. Unset falls back to support@datazag.com.
SUPPORT_EMAIL_TO=
